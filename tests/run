#!/usr/bin/env bash
# Run the image test suite: tests/run IMAGE [tests/cases/NAME.sh ...]
set -uo pipefail

if [ $# -lt 1 ]; then
    echo "usage: tests/run IMAGE [tests/cases/NAME.sh ...]" >&2
    exit 2
fi
export IMAGE=$1
shift
cd "$(dirname "$0")/.."

cases=("$@")
[ ${#cases[@]} -gt 0 ] || cases=(tests/cases/*.sh)

failed=()
for c in "${cases[@]}"; do
    echo "=== ${c}"
    bash "$c" || failed+=("$c")
done

if [ ${#failed[@]} -gt 0 ]; then
    printf 'FAILED: %s\n' "${failed[@]}" >&2
    exit 1
fi
echo "all ${#cases[@]} test cases passed"
