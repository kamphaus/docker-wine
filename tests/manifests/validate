#!/usr/bin/env bash
# Render every kustomization and validate it; assert the security-relevant fields of the base.
set -euo pipefail
cd "$(dirname "$0")/../.."
KUBECONFORM=ghcr.io/yannh/kubeconform:v0.8.0@sha256:faffaf43f95aa6425306e1ab8d6fcad72acb9049158f38e574c085ea1ec0f64e

fail() { echo "FAIL [manifests]: $*" >&2; exit 1; }

for dir in deploy/openshift/base deploy/openshift/overlays/example-user tests/k8s/overlay; do
    kubectl kustomize "$dir" | docker run --rm -i "$KUBECONFORM" -strict -summary - || fail "$dir does not validate"
done

base=$(kubectl kustomize deploy/openshift/base)
! grep -q '^kind: Service$' <<<"$base" || fail "base must not contain a Service"
! grep -q '^kind: Route$' <<<"$base" || fail "base must not contain a Route"
for want in 'automountServiceAccountToken: false' 'enableServiceLinks: false' 'allowPrivilegeEscalation: false' \
    'runAsNonRoot: true' 'type: RuntimeDefault' 'readOnlyRootFilesystem: true' '- ALL' 'type: Recreate' \
    'value: 127.0.0.1' 'medium: Memory'; do
    grep -qF -- "$want" <<<"$base" || fail "base is missing '$want'"
done
! grep -q 'runAsUser:' <<<"$base" || fail "base must let the SCC assign runAsUser"

# The deny-ingress policy must select the Deployment's pods (podSelector labels a subset of the pod template labels).
check_selectors() {
    python3 -c '
import sys, yaml
docs = [d for d in yaml.safe_load_all(sys.stdin) if d]
dep = next(d for d in docs if d["kind"] == "Deployment")
tmpl = dep["spec"]["template"]["metadata"]["labels"]
sel = dep["spec"]["selector"]["matchLabels"]
assert sel.items() <= tmpl.items(), "Deployment selector does not match its pod template"
nps = [d for d in docs if d["kind"] == "NetworkPolicy"]
ing = [d for d in nps if "Ingress" in d["spec"].get("policyTypes", []) and not d["spec"].get("ingress")]
assert ing, "no deny-ingress NetworkPolicy"
for np in nps:
    assert np["spec"]["podSelector"]["matchLabels"].items() <= tmpl.items(), np["metadata"]["name"] + " does not select the Deployment pods"
if len(sys.argv) > 1:
    assert tmpl.get("app.kubernetes.io/instance") == sys.argv[1], "instance label missing from pod template"
    assert sel.get("app.kubernetes.io/instance") == sys.argv[1], "instance label missing from Deployment selector"
    pvc = next(d for d in docs if d["kind"] == "PersistentVolumeClaim")
    assert pvc["spec"]["resources"]["requests"]["storage"] == "50Gi", "overlay PVC is not 50Gi"
' "$@"
}
check_selectors <<<"$base" || fail "base selector checks"
overlay=$(kubectl kustomize deploy/openshift/overlays/example-user)
check_selectors alice <<<"$overlay" || fail "example-user overlay selector checks"
echo "PASS [manifests]"
