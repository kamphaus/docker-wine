{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for docker-wine and images derived from it",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "vulnerabilityAlerts": { "enabled": true },
  "customManagers": [
    {
      "customType": "regex",
      "description": "ARG pins annotated with '# renovate:' (optionally followed by a matching _COMMIT pin)",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)(?:\\s+ARG \\w+_COMMIT=(?<currentDigest>[0-9a-f]{40}))?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "customType": "regex",
      "description": "downloads.lock entries annotated with '# renovate:'",
      "managerFilePatterns": ["/(^|/)[^/]+\\.lock$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+\\S+ (?<currentValue>\\S+) "
      ],
      "extractVersionTemplate": "{{#if extractVersion}}{{{extractVersion}}}{{else}}^(?<version>.+)${{/if}}"
    },
    {
      "customType": "regex",
      "description": "Workflow image pins like 'NAME: image:tag@sha256:digest' annotated with '# renovate: datasource=docker depName=image'",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: \\S+?:(?<currentValue>[^\\s@:]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Only native digest/pin updates automerge; custom.regex pins (tag+commit, downloads.lock, add-ons) never do",
      "matchManagers": ["dockerfile", "github-actions", "kustomize"],
      "matchUpdateTypes": ["digest", "pinDigest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Wine bumps change add-ons and behaviour: always review",
      "matchDepNames": ["winehq-stable"],
      "automerge": false
    }
  ]
}
